{# Ingress dédié au chemin /export, avec limites nginx (cf. defaults,
   judilibre_search_ingress_export_limit). nginx fusionne les Ingress d'un même
   hôte : le préfixe /export, plus long que /, prend ces règles ; le reste du
   trafic garde celles de l'Ingress principal.
   Les limites s'appliquent par IP source et par pod nginx : PISTE arrivant sur
   peu d'adresses, elles plafonnent l'ensemble de ses exports, ce qui est le
   but (protéger Elasticsearch). Le server-snippet reste sur l'Ingress
   principal : il vaut pour tout le serveur et ne doit pas être déclaré deux fois. #}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ judilibre_search_ingress_export_name }}
  namespace: {{ judilibre_search_namespace }}
  annotations:
    kubernetes.io/ingress.class: nginx
    nginx.ingress.kubernetes.io/proxy-body-size: {{ judilibre_search_ingress_body_size }}
    nginx.ingress.kubernetes.io/whitelist-source-range: "{{ judilibre_search_ingress_ranges | join(',') }}"
    nginx.ingress.kubernetes.io/limit-connections: "{{ judilibre_search_ingress_export_limit.connections }}"
    nginx.ingress.kubernetes.io/limit-rpm: "{{ judilibre_search_ingress_export_limit.rpm }}"
    nginx.ingress.kubernetes.io/limit-burst-multiplier: "{{ judilibre_search_ingress_export_limit.burst_multiplier }}"
spec:
  tls:
{% for entree in judilibre_search_ingress_hosts %}
    - hosts:
        - {{ entree.host }}
      secretName: {{ entree.tls_secret }}
{% endfor %}
  rules:
{% for entree in judilibre_search_ingress_hosts %}
    - host: {{ entree.host }}
      http:
        paths:
          - path: /export
            pathType: Prefix
            backend:
              service:
                name: {{ judilibre_search_service_name }}
                port:
                  number: {{ judilibre_search_service_port }}
{% endfor %}
