{# Annotation partagée par ingress.yaml.j2 et ingress-export.yaml.j2 : un
   même chemin n'est journalisé que si son Ingress la porte. #}
{% if judilibre_search_ingress_debug_headers_user_agent %}
    # Diagnostic temporaire (cf. defaults,
    # judilibre_search_ingress_debug_headers_user_agent) : écrit tous les
    # en-têtes reçus dans les logs nginx (ligne "piste_headers"), seulement
    # pour cet user-agent.
    nginx.ingress.kubernetes.io/configuration-snippet: |
      access_by_lua_block {
        if ngx.var.http_user_agent == "{{ judilibre_search_ingress_debug_headers_user_agent }}" then
          local masked = { {% for h in judilibre_search_ingress_debug_headers_masked %}["{{ h | lower }}"] = true, {% endfor %}}
          local out = {}
          for k, v in pairs(ngx.req.get_headers(100)) do
            out[k] = masked[k] and "***" or v
          end
          ngx.log(ngx.NOTICE, "piste_headers ", require("cjson.safe").encode({ uri = ngx.var.request_uri, headers = out }))
        end
      }
{% endif %}
